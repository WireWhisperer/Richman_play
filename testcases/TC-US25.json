{
  "schema_version": "1.0",
  "user_story": "US25",
  "tests": [
    {
      "case_id": "TC-US25-001",
      "case_name": "自动化脚本调用STEP命令正确移动",
      "map_file": "map.json",
      "preset": {
        "users": ["A", "Q"],
        "current_user": "A",
        "phase": "COMMAND",
        "game_status": "RUNNING",
        "players": [
          {"id": "A", "fund": 1000, "credit": 0, "position": 0, "status": "NORMAL", "remaining_rounds": 0, "items": {"BLOCK": 0, "BOMB": 0, "ROBOT": 0}, "god_of_wealth_rounds": 0},
          {"id": "Q", "fund": 1000, "credit": 0, "position": 20, "status": "NORMAL", "remaining_rounds": 0, "items": {"BLOCK": 0, "BOMB": 0, "ROBOT": 0}, "god_of_wealth_rounds": 0}
        ],
        "properties": [],
        "map_items": [],
        "dice_sequence": []
      },
      "actions": [
        {"command": "STEP", "params": {"steps": 3}}
      ],
      "expected": {
        "players": [{"id": "A", "position": 3}]
      }
    },
    {
