      "preset": {
        "users": ["A", "Q"],
        "current_user": "A",
        "phase": "COMMAND",
        "game_status": "RUNNING",
        "players": [
          {"id": "A", "fund": 1000, "credit": 0, "position": 2, "status": "NORMAL", "remaining_rounds": 0, "items": {"BLOCK": 1, "BOMB": 0, "ROBOT": 0}, "god_of_wealth_rounds": 0},
          {"id": "Q", "fund": 1000, "credit": 0, "position": 20, "status": "NORMAL", "remaining_rounds": 0, "items": {"BLOCK": 0, "BOMB": 0, "ROBOT": 0}, "god_of_wealth_rounds": 0}
        ],
        "properties": [],
        "map_items": [],
        "dice_sequence": []
      },
      "actions": [
        {"command": "BLOCK", "params": {"offset": -4}}
      ],
      "expected": {
        "players": [{"id": "A", "items": {"BLOCK": 0}}],
        "map_items": [{"position": 68, "type": "BLOCK"}]
      }
    },
