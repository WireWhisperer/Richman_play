{
  "schema_version": "1.0",
  "tests": [
    {
      "case_id": "TC-US02_1",
      "case_name": "非法资金重输后成功设置",
      "preset": {"cash": ["100", "5000"], "players": "12"},
      "actions": [],
      "expected": {
        "exit_code": 0,
        "contains": ["金额不能小于1000", "请选择 2~4 位玩家"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC-US02_2",
      "case_name": "设置初始资金失败",
      "preset": {"cash": "1000000", "players": "12"},
      "actions": [],
      "expected": {
        "exit_code": 0,
        "contains": ["金额不能大于50000"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC-US02_3",
      "case_name": "设置初始资金失败",
      "preset": {"cash": "dwdwd", "players": "12"},
      "actions": [],
      "expected": {
        "exit_code": 0,
        "contains": ["输入不规范，请输入纯数字！"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC001",
      "case_name": "启动与查询初始资产",
      "preset": { "cash": "10000", "players": "12", "toolnum": 0 },
      "actions": ["query", "quit"],
      "expected": {
        "exit_code": 0,
        "contains": ["玩家：钱夫人 资金：10000 位置：0"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC002",
      "case_name": "step 移动",
      "preset": { "cash": "10000", "players": "12", "toolnum": 0 },
      "actions": ["step 3", "n", "query", "quit"],
      "expected": {
        "exit_code": 0,
        "contains": ["资金：10000 位置：3"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC003",
      "case_name": "购买空地成功",
      "preset": { "cash": "10000", "players": "12", "toolnum": 0 },
      "actions": ["step 1", "y", "query", "quit"],
      "expected": {
        "exit_code": 0,
        "contains": ["购买成功", "资金：9800"],
        "not_contains": ["资金不足"]
      }
    },
    {
      "case_id": "TC004",
      "case_name": "拒绝购买资金不变",
      "preset": { "cash": "10000", "players": "12", "toolnum": 0 },
      "actions": ["step 1", "n", "query", "quit"],
      "expected": {
        "exit_code": 0,
        "contains": ["资金：10000"],
        "not_contains": ["购买成功"]
      }
    },
    {
      "case_id": "TC005",
      "case_name": "命令忽略大小写",
      "preset": { "cash": "10000", "players": "12", "toolnum": 0 },
      "actions": ["STEP 2", "n", "QUERY", "QUIT"],
      "expected": {
        "exit_code": 0,
        "contains": ["资金：10000 位置：2", "游戏结束"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC006",
      "case_name": "进入商店购物",
      "preset": { "cash": "3000", "players": "12", "toolnum": 0 },
      "actions": ["STEP 6", "QUIT"],
      "expected": {
        "exit_code": 0,
        "contains": ["自由选购", "进入商店，开始购物"],
        "not_contains": []
      }
    },
    {
      "case_id": "TC007",
      "case_name": "进入商店购物后现金不足弹出",
      "preset": { "cash": "1000", "players": "12", "toolnum": 0 },
      "actions": ["STEP 1", "y", "STEP 1", "y", "STEP 1", "y", "STEP 1", "y", "STEP 1", "y", "STEP 1", "QUIT"],
      "expected": {
        "exit_code": 0,
        "contains": ["资金不足，自动离开", "进入商店，开始购物"],
        "not_contains": []
      }
    }
  ]
}
